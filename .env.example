# MongoDB (required)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=speedway_anointed_ent

# JWT (required - DO NOT use the default in production)
JWT_SECRET=change-me-in-production

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail OAuth (required for email service)
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
OWNER_EMAIL=
NOTIFICATION_COPY_EMAILS=

# Image provider APIs (optional)
PEXEL_API=
UNSPLASH_ACCESSKEY=
UNSPLASH_SECRETKEY=
FREEPIK_API_KEY=

# AI services (optional)
GEMINI_API_KEY=
RESEND_API=

# Public URL (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Cron health checks (optional, for production)
SELF_PING_URL=
SELF_PING_MINUTES=5
